# Waitlist signup configuration. Server-side only: never prefix these with PUBLIC_.
# See docs/WAITLIST-PROVIDER.md.
#
# `astro dev` reads a local .env file (copy this one; do not commit it).
# The built Node server does NOT read .env on its own: set these in the host's
# environment, or run `node --env-file=.env ./dist/server/entry.mjs`.

# Signup destination.
#   (empty) -> unconfigured: every signup answers 503 "unavailable" (the safe default)
#   test    -> controlled test destination for UI state testing only; refused
#              outside `astro dev` unless WAITLIST_ALLOW_TEST_PROVIDER=1
#   <name>  -> a real adapter registered in src/lib/waitlist/providers/index.ts
WAITLIST_PROVIDER=

# Set to 1 to allow WAITLIST_PROVIDER=test in a built or preview server.
# Never set this in production.
WAITLIST_ALLOW_TEST_PROVIDER=

# Test destination only: "double-opt-in" simulates a provider that sends a
# confirmation email. Default (empty): single opt-in.
WAITLIST_TEST_CONFIRMATION=

# Best-effort, per-process rate limit: attempts per client address per window.
# Defaults: 20 attempts per 600 seconds (small teams often share one office address). Raise locally while testing UI states.
WAITLIST_RATE_LIMIT=
WAITLIST_RATE_WINDOW_SECONDS=

# Number of reverse proxies in front of the server that append the connecting
# address to X-Forwarded-For (1 for a single nginx / load balancer). The limiter
# then keys on that entry from the right of the header. Default (empty): 0, the
# header is ignored and the adapter's TCP peer address is used. Only set this when
# the Node port is reachable solely through those proxies. Do not rely on Astro's
# security.allowedDomains for client addresses: it trusts the left-most, forgeable
# entry. See "Deployment notes" in docs/WAITLIST-PROVIDER.md.
WAITLIST_TRUSTED_PROXY_HOPS=

# Real provider credentials go below once a provider is chosen (names depend on
# the adapter), for example:
# EXAMPLE_API_KEY=
# EXAMPLE_LIST_ID=
