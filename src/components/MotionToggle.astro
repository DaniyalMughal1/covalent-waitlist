---
// Stops ambient motion site-wide (WCAG 2.2.2). See src/scripts/motion-toggle.ts.
---

<button class="motion-toggle" type="button" data-motion-toggle data-visible="false" aria-label="Pause motion" hidden>
  <svg class="icon-pause" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d="M5.25 3.5v9M10.75 3.5v9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  </svg>
  <svg class="icon-play" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d="M5 3.4v9.2L12.6 8Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
  </svg>
</button>

<style>
  .motion-toggle {
    position: fixed;
    right: max(16px, var(--gutter));
    bottom: max(6px, env(safe-area-inset-bottom));
    z-index: 30;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    opacity: 0;
    visibility: hidden;
    transition: opacity 240ms ease, visibility 0s 240ms, background-color var(--hover) ease, border-color var(--hover) ease;
  }
  .motion-toggle[hidden] {
    display: none;
  }
  .motion-toggle[data-visible="true"] {
    opacity: 1;
    visibility: visible;
    transition: opacity 240ms ease, background-color var(--hover) ease, border-color var(--hover) ease;
  }
  .motion-toggle:hover {
    border-color: var(--ink);
  }
  .motion-toggle:focus-visible {
    border-radius: 50%;
  }
  .motion-toggle svg {
    grid-area: 1 / 1;
    width: 16px;
    height: 16px;
  }
  .icon-play {
    display: none;
  }
  .motion-toggle[data-paused="true"] .icon-play {
    display: block;
  }
  .motion-toggle[data-paused="true"] .icon-pause {
    display: none;
  }
  .no-js .motion-toggle {
    display: none;
  }
</style>
