---
import { Picture } from "astro:assets";
import WaitlistForm from "./WaitlistForm.astro";
import { copy } from "../config/site";
import markPoster from "../assets/mark-poster.png";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <h1 class="hero-title" id="hero-title">
      <span>{copy.headline[0]}</span>
      <em>{copy.headline[1]}</em>
    </h1>
    <WaitlistForm id="join" source="hero" label={copy.heroFieldLabel} class="hero-form" />
  </div>

  <div class="hero-object">
    <div class="hero-stage" data-hero-stage data-motion-surface>
      <script is:inline>
        // Hide only the static poster while the first complete animated frame prepares.
        // Without JavaScript the original image remains visible.
        document.currentScript.parentElement.dataset.arrivalPending = "";
      </script>
      <Picture
        class="hero-poster"
        src={markPoster}
        alt="The Covalent mark in polished silver: a flat-topped hexagon holding three short bonds."
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        widths={[340, 460, 640, 920, 1280]}
        sizes="(max-width: 560px) min(100vw - 40px, 340px), (max-width: 999px) min(100vw - 40px, 460px), min(50vw, 640px, 68svh)"
        loading="eager"
        decoding="sync"
        fetchpriority="high"
      />
    </div>
  </div>

</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 47fr) minmax(0, 53fr);
    grid-template-rows: minmax(0, 1fr);
    width: min(var(--max), 100%);
    min-height: max(600px, 100svh);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  @media (min-width: 1000px) {
    .hero {
      padding-bottom: clamp(100px, 18svh, 180px);
    }
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding-block: 24px;
  }

  .hero-kicker {
    margin-bottom: clamp(20px, 3svh, 32px);
  }

  /* Two deliberate lines, whatever the width. */
  .hero-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-variation-settings: "EXPO" -4;
    font-size: clamp(72px, 7.3vw, 128px);
    line-height: 0.94;
    letter-spacing: -0.055em;
    margin-bottom: clamp(36px, 5svh, 56px);
    margin-left: -0.03em;
  }
  .hero-title > * {
    display: block;
    white-space: nowrap;
  }
  .hero-title em {
    font-style: normal;
    color: var(--quiet);
  }

  .hero-body {
    max-width: 19.6em;
    margin-bottom: clamp(24px, 3.6svh, 38px);
    font-size: 18px;
    line-height: 1.5;
    color: var(--muted);
  }
  .hero-body span {
    display: block;
  }
  /* Too narrow for the set lines: the last two run together rather than leaving an orphan. */
  @media (max-width: 379px) {
    .hero-body span + span {
      display: inline;
    }
  }

  .hero-object {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  /* Stable square: the poster and the canvas share it, so neither can shift the layout. */
  .hero-stage {
    position: relative;
    width: min(100%, 640px, 68svh);
    aspect-ratio: 1;
  }
  .hero-stage :global(.hero-poster),
  .hero-stage :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .hero-stage[data-interactive] {
    cursor: grab;
    touch-action: pan-y pinch-zoom;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .hero-stage[data-arrival-pending] :global(.hero-poster) {
    visibility: hidden;
  }
  .hero-stage[data-dragging] {
    cursor: grabbing;
  }
  /* Nothing to drag here: a press only ever turns the bonds. */
  @media (prefers-reduced-motion: reduce) {
    .hero-stage[data-interactive] {
      cursor: pointer;
    }
  }
  /* Drawn inside the stage: the caption is pulled up into its bottom edge, and the mark's
     margin leaves room here at every size. */
  .hero-stage:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: -12px;
    border-radius: 16px;
  }

  .object-caption {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    width: min(100%, 520px);
    min-height: 1.4em;
    margin-top: -8px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--muted);
  }

  .scroll-cue {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    border-top: 1px solid var(--line);
    font-size: 15px;
    color: var(--ink-2);
  }
  .scroll-cue svg {
    width: 16px;
    height: 16px;
    margin-right: 68px;
    transition: transform 240ms var(--ease-out);
  }
  .scroll-cue:hover svg {
    transform: translateY(3px);
  }

  /* Copy and signup come first; the object follows. */
  @media (max-width: 999px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      min-height: 0;
    }
    .hero-copy {
      padding-block: clamp(32px, 6svh, 56px) 8px;
    }
    .hero-title {
      font-size: clamp(46px, min(15.6vw, 15svh), 112px);
    }
    /* Set lines are a nicety here: under enlarged text spacing they have to be able to wrap. */
    .hero-title > * {
      white-space: normal;
    }
    .hero-stage {
      width: min(100%, 460px);
    }
    .object-caption {
      width: min(100%, 460px);
    }
    .scroll-cue {
      margin-top: 24px;
    }
  }

  /* A short window (200% zoom, a phone on its side): the form still has to be in the first
     view, so the copy gives up its set lines and most of its air. */
  @media (max-width: 999px) and (max-height: 620px) {
    .hero-copy {
      padding-block: 24px 8px;
    }
    .hero-kicker,
    .hero-title {
      margin-bottom: 10px;
    }
    .hero-body {
      max-width: none;
      margin-bottom: 12px;
    }
    .hero-body span {
      display: inline;
    }
  }
  @media (max-width: 999px) and (max-height: 420px) {
    .hero-kicker {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .hero-stage {
      width: min(100%, 340px);
    }
  }

  /* The pause control is fixed in the bottom right corner, so the hint keeps clear of it.
     Two lines are reserved from the start, so the hint appearing moves nothing. */
  @media (max-width: 640px) {
    .object-caption {
      flex-direction: column;
      gap: 0;
      min-height: 2.8em;
    }
  }
</style>
