---
// Keep the optional Explore disclosure available for the future full site.
const showExplore = false;
import { copy } from "../config/site";

const destinations = [
  { href: "#how-it-works", title: "How agents coordinate", line: "Shared context, claims and handoffs." },
  { href: "#questions", title: "A little more context", line: "Who it’s for and where it works." },
  { href: "#access", title: "Get early access", line: "Join the waitlist and we’ll email you." },
];

// The short form of the label on phones; the full phrase stays the accessible name.
const [actionFirst, ...actionRest] = copy.action.split(" ");
---

<header class="site-header" data-site-header>
  <div class="header-row">
    <nav class="header-nav" aria-label="Primary">
      {showExplore && (
      <div class="explore" data-explore>
        <a class="explore-toggle explore-link" href="#how-it-works" data-explore-fallback>Explore</a>
        <button
          class="explore-toggle explore-button"
          type="button"
          aria-expanded="false"
          aria-controls="explore-panel"
          data-explore-trigger
          hidden
        >
          Explore
          <svg class="explore-plus" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
            <path d="M6 1v10M1 6h10" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
          </svg>
        </button>

        <div class="explore-panel" id="explore-panel" data-explore-panel>
          <div class="explore-grid">
            <div class="explore-intro">
              <p class="explore-name">Covalent</p>
              <p class="explore-about">{copy.footerLine}</p>
            </div>
            <ol class="explore-list" role="list">
              {
                destinations.map((item, index) => (
                  <li class="explore-item" style={`--i:${index}`}>
                    <a class="explore-destination" href={item.href}>
                      <span class="explore-index" aria-hidden="true">
                        {String(index + 1).padStart(2, "0")}
                      </span>
                      <span class="explore-title">{item.title}</span>
                      <span class="explore-line">{item.line}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
        <div class="explore-scrim" aria-hidden="true" data-explore-scrim></div>
      </div>
      )}

      <a class="header-cta" href="#join" aria-label={copy.action} data-focus-email>
        <span class="cta-label">{actionFirst}<span class="cta-rest"> {actionRest.join(" ")}</span></span>
        <span class="cta-disc" aria-hidden="true">
          <svg viewBox="0 0 20 20" focusable="false">
            <path d="M5.5 14.5 14.5 5.5M7 5.5h7.5V13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>
    </nav>
  </div>
</header>

<style>
  /* Solid paper, never a blur: this sits above everything for the whole scroll. */
  .site-header {
    position: sticky;
    top: 0;
    /* Under the skip link, which shares the header's corner. */
    z-index: 19;
    background: var(--paper);
  }
  .site-header::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--line);
    opacity: 0;
    transition: opacity var(--hover) ease;
  }
  .site-header[data-scrolled]::after {
    opacity: 1;
  }
  :global(.no-js) .site-header::after {
    opacity: 1;
  }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: min(var(--max), 100%);
    height: var(--header-h);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .brand {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
  }
  .brand :global(.brand-mark) {
    width: 30px;
    height: auto;
    color: var(--ink);
  }
  .brand-word {
    font-family: var(--font-display);
    font-size: 28px;
    font-variation-settings: "EXPO" -8;
    letter-spacing: -0.045em;
    line-height: 1;
    padding-bottom: 3px;
  }

  .header-nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 40px;
    min-width: 0;
    font-size: 15px;
    white-space: nowrap;
  }

  /* The link and the button share one box, so the swap at start-up moves nothing. */
  .explore-toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: text-decoration-color var(--hover) ease;
  }
  .explore-toggle[hidden] {
    display: none;
  }
  .explore-link {
    padding-inline-end: 22px;
  }
  .explore-plus {
    flex: none;
    width: 12px;
    height: 12px;
    transition: transform 320ms var(--ease-out);
  }
  .explore-button[aria-expanded="true"] .explore-plus {
    transform: rotate(45deg);
  }
  @media (hover: hover) {
    .explore-toggle:hover {
      text-decoration-color: currentColor;
    }
    .explore-button[aria-expanded="false"]:hover .explore-plus {
      transform: rotate(90deg);
    }
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    min-height: 44px;
    color: var(--ink);
  }
  .cta-disc {
    flex: none;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    transition: transform 320ms var(--ease-out), background-color var(--hover) ease;
  }
  .cta-disc svg {
    width: 18px;
    height: 18px;
  }
  .header-cta:focus-visible {
    border-radius: 24px;
  }
  @media (hover: hover) {
    .header-cta:hover .cta-disc {
      transform: rotate(45deg);
      background: var(--cobalt);
    }
  }

  /* ---------- the panel ---------- */

  /* Hidden means hidden: visibility drops the links out of the tab order, and its delay
     lets the closing transition finish first. */
  .explore-panel {
    --focus: #f3f1ec;
    position: absolute;
    inset: 100% 0 auto;
    z-index: 1;
    max-height: calc(100svh - var(--header-h));
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--ink);
    color: #f6f4ef;
    white-space: normal;
    visibility: hidden;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 200ms var(--ease-in-out), visibility 0s 200ms;
  }
  .explore-button[aria-expanded="true"] ~ .explore-panel {
    visibility: visible;
    clip-path: inset(0);
    transition: clip-path 360ms var(--ease-out), visibility 0s;
  }

  .explore-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 3fr);
    gap: 32px;
    width: min(var(--max), 100%);
    margin-inline: auto;
    padding: 36px var(--gutter) 44px;
  }
  .explore-intro {
    padding-top: 13px;
  }
  .explore-name {
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
  }
  .explore-about {
    max-width: 24ch;
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.5;
    color: #bcc2ca;
  }

  .explore-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .explore-item {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 140ms ease, transform 0s 200ms;
  }
  .explore-button[aria-expanded="true"] ~ .explore-panel .explore-item {
    opacity: 1;
    transform: none;
    /* Timed so the last item comes to rest at 396ms, with the panel's own 360ms clip. */
    transition:
      opacity 240ms ease calc(60ms + var(--i) * 36ms),
      transform 264ms var(--ease-out) calc(60ms + var(--i) * 36ms);
  }

  .explore-destination {
    display: grid;
    gap: 10px;
    min-height: 44px;
    padding-top: 12px;
    border-top: 1px solid rgb(255 255 255 / 0.18);
    transition: border-color var(--hover) ease;
  }
  .explore-index {
    font-size: 13px;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
    color: #bcc2ca;
  }
  /* Every title breaks onto two lines, so the three plain lines start on one level. */
  .explore-title {
    max-width: 6.4em;
    margin-top: 10px;
    font-family: var(--font-display);
    font-size: clamp(28px, 1.2rem + 1.2vw, 38px);
    font-weight: 400;
    font-variation-settings: "EXPO" -4;
    letter-spacing: -0.03em;
    line-height: 1.04;
    text-wrap: balance;
  }
  /* One line where the column allows it; never a lone word where it does not. */
  .explore-line {
    font-size: 15px;
    line-height: 1.45;
    color: #bcc2ca;
    text-wrap: balance;
  }
  @media (hover: hover) {
    .explore-destination:hover {
      border-top-color: #f6f4ef;
    }
  }
  .explore-destination:focus-visible {
    outline-offset: 6px;
  }

  /* The page softens behind the panel with a plain wash. It is not a modal: nothing is
     trapped, and a click here is just a click outside. */
  .explore-scrim {
    position: fixed;
    inset: var(--header-h) 0 0;
    background: rgb(250 249 246 / 0.72);
    opacity: 0;
    visibility: hidden;
    transition: opacity 200ms ease, visibility 0s 200ms;
  }
  .explore-button[aria-expanded="true"] ~ .explore-scrim {
    opacity: 1;
    visibility: visible;
    transition: opacity 280ms ease, visibility 0s;
  }

  /* Paused or reduced: the panel still works, it just arrives. */
  [data-instant] :is(.explore-panel, .explore-scrim, .explore-item, .explore-plus, .cta-disc) {
    transition: none !important;
  }
  @media (prefers-reduced-motion: reduce) {
    :is(.explore-panel, .explore-scrim, .explore-item) {
      transition: none !important;
    }
  }

  /* ---------- narrow ---------- */

  @media (max-width: 960px) {
    .explore-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-block: 24px 32px;
    }
    .explore-intro {
      padding-top: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0 16px;
    }
    .explore-about {
      max-width: none;
      margin-top: 0;
    }
  }

  @media (max-width: 720px) {
    .explore-list {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .explore-destination {
      grid-template-columns: 32px minmax(0, 1fr);
      gap: 4px 8px;
      padding-block: 14px 16px;
    }
    .explore-index {
      padding-top: 6px;
    }
    .explore-title {
      max-width: none;
      margin-top: 0;
      font-size: 26px;
    }
    .explore-line {
      grid-column: 2;
    }
  }

  /* Phones keep one line: the label shortens to its verb, and at the very narrowest the
     plus goes too, because the word Explore and the verb matter more than the glyph. */
  @media (max-width: 560px) {
    .header-nav {
      gap: 20px;
    }
    .header-cta {
      gap: 10px;
    }
    .cta-rest {
      display: none;
    }
  }
  @media (max-width: 369.98px) {
    .brand {
      gap: 7px;
    }
    .brand :global(.brand-mark) {
      width: 25px;
    }
    .brand-word {
      font-size: 24px;
    }
    .header-row {
      gap: 8px;
    }
    .header-nav {
      gap: 14px;
      font-size: 14px;
    }
    .header-cta {
      gap: 7px;
    }
    .cta-disc {
      width: 36px;
      height: 36px;
    }
    .explore-plus {
      display: none;
    }
    .explore-link {
      padding-inline-end: 0;
    }
  }

  @media (forced-colors: active) {
    .brand :global(.brand-mark) {
      color: CanvasText;
    }
    .cta-disc {
      border: 1px solid ButtonText;
    }
    .explore-panel {
      border-bottom: 1px solid CanvasText;
    }
  }
</style>
